{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenDeck",
  "version": "0.1.0",
  "identifier": "dev.opendeck.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenDeck Settings",
        "width": 480,
        "height": 600,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "OpenDeck — Macro Controller",
      "menuOnLeftClick": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist"
    }
  }
}
